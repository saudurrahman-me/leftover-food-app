rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ── AI Dataset Rules ──────────────────────────────────────────
    match /food_ai_dataset/{allPaths=**} {
      // Uploads happen exclusively via backend Cloud Function (Admin SDK bypasses rules)
      allow create: if false;
      // Dataset images should never be overwritten/updated
      allow update: if false; 
      // Only Admins can view or delete the dataset images
      allow read, delete: if firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }
    
    // ── Default Fallback Rule ─────────────────────────────────────
    // If you have other paths, allow authenticated users to read/write them by default
    // or adjust these according to your previous needs.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
